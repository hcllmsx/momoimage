{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "momoimage",
  "main": "./src/api/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist"
  },
  // R2 存储桶绑定 — 在 Cloudflare 控制台创建 R2 Bucket 后填入 bucket_name
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "momoimage"
    }
  ],
  // KV 命名空间绑定 — 在 Cloudflare 控制台创建 KV 后填入 id
  "kv_namespaces": [
    {
      "binding": "KV_META",
      "id": "68c5306cf3b94cf08c766f6f6178169e" // 部署前在 Cloudflare 控制台创建 KV 命名空间并替换此值
    }
  ],
  // 环境变量 — 可在 Cloudflare 控制台的「设置 -> 变量和机密」中配置自定义的 ADMIN_PASSWORD（默认密码为 momoimage）
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}