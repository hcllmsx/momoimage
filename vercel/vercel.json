{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "runtime": "edge"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/i/(.*)",
      "dest": "api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!api|i)(.*)",
      "dest": "/index.html"
    }
  ]
}
